NODE_ENV=development
# Neon pooled URL for the API and notification worker (hostname includes -pooler).
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/coach_rickie?sslmode=require
# Neon direct URL for Prisma migrations (hostname does not include -pooler).
