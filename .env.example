NODE_ENV=development
# Neon pooled URL for the API (hostname includes -pooler).
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/project?sslmode=require
# Neon direct URL for Prisma migrations (hostname does not include -pooler).
DIRECT_URL=postgresql://user:password@ep-example.region.aws.neon.tech/coach_rickie?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:3002
PUBLIC_APP_URL=http://localhost:3002
API_URL=http://localhost:4000
# Production web deployments proxy /api to this origin, keeping admin cookies first-party.
API_ORIGIN=https://service-scheduler-ci6s.onrender.com
RESEND_API_KEY=
EMAIL_FROM=Coach Rickie <bookings@example.com>
# Optional Gmail SMTP. When both are set, Gmail is used instead of Resend.
# Create an App Password in the Google account's Security settings; never use its normal password.
GMAIL_SMTP_USER=company@gmail.com
GMAIL_SMTP_APP_PASSWORD=
CONTACT_RECIPIENT_EMAIL=info@coachrickie.com
WHATSAPP_ENABLED=false
WHATSAPP_SENDER_NUMBER=256.....
WHATSAPP_AUTH_PATH=/tmp/baileys-auth
ADMIN_WHATSAPP_RECIPIENT=256.....
WHATSAPP_R2_BUCKET=coach-rickie-whatsapp-session
WHATSAPP_R2_ACCOUNT_ID=🤝
WHATSAPP_R2_ACCESS_KEY_ID=
WHATSAPP_R2_SECRET_ACCESS_KEY=
WHATSAPP_R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
SEED_ADMIN_EMAIL=admin@trial.com
SEED_ADMIN_PASSWORD=ThisPassword0123!
